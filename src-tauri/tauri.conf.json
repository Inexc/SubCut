{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SubCut",
  "version": "0.1.0",
  "identifier": "com.subcut.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SubCut",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 720,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#09090b"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
